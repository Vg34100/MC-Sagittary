{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:charge_type",
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "scale": 0.08,
        "fallback": {"type": "minecraft:model", "model": "sagittary:item/repeater_crossbow_pulling_0"},
        "entries": [
          {"threshold": 0.58, "model": {"type": "minecraft:model", "model": "sagittary:item/repeater_crossbow_pulling_1"}},
          {"threshold": 1.0, "model": {"type": "minecraft:model", "model": "sagittary:item/repeater_crossbow_pulling_2"}}
        ]
      },
      "on_false": {"type": "minecraft:model", "model": "sagittary:item/repeater_crossbow"}
    },
    "cases": [
      {"when": "arrow", "model": {"type": "minecraft:model", "model": "sagittary:item/repeater_crossbow_arrow"}},
      {"when": "rocket", "model": {"type": "minecraft:model", "model": "sagittary:item/repeater_crossbow_firework"}}
    ]
  }
}
